# =============================================================================
# RankInAI — environment configuration
#
# Copy to `.env` for local development. Never commit a populated `.env`.
# Generate secrets with:  openssl rand -base64 48
# =============================================================================

# --- Core (REQUIRED) ---------------------------------------------------------
NODE_ENV=development

# PostgreSQL connection string. On Railway, reference the Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://rankinai:rankinai@127.0.0.1:5432/rankinai

# Auth.js session signing secret. REQUIRED in production — the app refuses to
# boot without it. Generate: openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-48-byte-random-string

# Required on Railway (and any host behind a proxy) so Auth.js trusts the
# forwarded host header.
AUTH_TRUST_HOST=true

# Public origin of the deployed app. Used for canonical URLs, OG tags, sitemap,
# Stripe redirect URLs and password-reset links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email address that receives the SUPER_ADMIN role on seed.
SUPER_ADMIN_EMAIL=admin@rankinai.com

# Local/dev seeding only. Leave unset in production and set the password via a
# one-off password reset instead.
SUPER_ADMIN_SEED_PASSWORD=

# --- Stripe (REQUIRED for live billing) --------------------------------------
# Test-mode keys start with sk_test_ / whsec_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs produced by `npm run stripe:setup`. Never hardcode these in source.
STRIPE_PRICE_ONE_TIME_AUDIT=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_AGENCY_MONTHLY=

# When "true", checkout is simulated locally instead of calling Stripe. Used by
# the automated test suite and local development. The UI shows a permanent
# test-mode banner while this is on, and it is REFUSED in production unless
# BILLING_TEST_MODE_ALLOW_PRODUCTION is also explicitly set.
BILLING_TEST_MODE=true
BILLING_TEST_MODE_ALLOW_PRODUCTION=false

# --- OpenAI report enhancement (OPTIONAL) ------------------------------------
# When absent, audits still run end to end using deterministic report templates.
# The LLM never alters directly observed evidence or category scores.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Public-web search observations (OPTIONAL) -------------------------------
# SEARCH_PROVIDER: "none" (default) | "serper"
SEARCH_PROVIDER=none
SERPER_API_KEY=

# --- Email (OPTIONAL in dev, RECOMMENDED in production) ----------------------
# EMAIL_PROVIDER: "console" (default in dev — logs the message and stores it for
# tests) | "resend"
EMAIL_PROVIDER=console
EMAIL_FROM="RankInAI <no-reply@rankinai.com>"
EMAIL_PROVIDER_API_KEY=
SUPPORT_EMAIL=support@rankinai.com

# --- Worker & scheduled jobs -------------------------------------------------
# Shared secret protecting the worker-trigger and cron HTTP endpoints.
CRON_SECRET=
AUDIT_WORKER_SECRET=

# Worker tuning (OPTIONAL — sensible defaults applied when unset).
WORKER_POLL_INTERVAL_MS=4000
WORKER_CONCURRENCY=1
WORKER_ID=

# --- Crawler tuning (OPTIONAL) -----------------------------------------------
CRAWL_TIMEOUT_MS=15000
CRAWL_MAX_BYTES=3000000
CRAWL_MAX_REDIRECTS=5
CRAWL_DELAY_MS=400
CRAWL_USER_AGENT="RankInAI-Auditor/1.0 (+https://rankinai.com/crawler)"

# --- Testing only ------------------------------------------------------------
# Allows the crawler to reach a loopback fixture server. MUST remain unset in
# production; the app hard-fails if it is set while NODE_ENV=production.
ALLOW_TEST_FIXTURE_HOST=
TEST_FIXTURE_ORIGIN=http://127.0.0.1:4321

# --- Optional third-party analytics ------------------------------------------
# The product works fully without any external tracker.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ANALYTICS_ENABLED=true
