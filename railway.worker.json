{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --include=dev --no-audit --no-fund && npm run db:generate"
  },
  "deploy": {
    "startCommand": "npm run worker",
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
