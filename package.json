{
  "name": "rankinai",
  "version": "1.0.0",
  "private": true,
  "description": "RankInAI — AI visibility and Generative Engine Optimization audit platform.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:all": "concurrently -n web,worker -c cyan,magenta \"npm run dev\" \"npm run worker:dev\"",
    "build": "prisma generate && next build",
    "start": "node scripts/start-web.js",
    "worker": "tsx src/worker/main.ts",
    "worker:dev": "tsx watch src/worker/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "audit:full-test": "tsx scripts/full-audit-validation.ts",
    "fixture:serve": "tsx tests/fixtures/server.ts",
    "security:audit": "npm audit --audit-level=high",
    "verify": "tsx scripts/verify.ts",
    "lint:fix": "eslint . --fix"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "bcryptjs": "3.0.2",
    "cheerio": "^1.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^0.545.0",
    "next": "15.5.23",
    "next-auth": "5.0.0-beta.32",
    "pdfkit": "^0.17.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.10.1",
    "sonner": "2.0.7",
    "stripe": "22.4.0",
    "tailwind-merge": "3.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.18.1",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "dotenv": "17.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "15.5.23",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "3.2.7"
  }
}
